{
  "jobs": [
    {
      "functionLocation": "/leviath-core.js",
      "functionName": "recordSnapshot",
      "description": "Record Leviath's Roblox stats for the growth charts",
      "executionConfig": {
        "cronExpression": "0 * * * *"
      }
    },
    {
      "functionLocation": "/leviath-scout.js",
      "functionName": "runScout",
      "description": "Scout: find young Roblox games and track how they're growing",
      "executionConfig": {
        "cronExpression": "20 * * * *"
      }
    }
  ]
}
